<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:markup="clr-namespace:PhosphorIconsAvalonia.Markup;assembly=PhosphorIconsAvalonia"
             xmlns:vm="clr-namespace:Jammer_desktop.ViewModels"
             xmlns:views="clr-namespace:Jammer_desktop.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Jammer_desktop.Views.GeneralView"
             x:DataType="vm:GeneralViewModel">
    
    <UserControl.Styles>
        
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,-12,0"/>
        </Style>
        
        <Style Selector="Button:pressed PathIcon.caret">
            <Setter Property="Foreground" Value="#C9444A"/>
        </Style>
    </UserControl.Styles>
    
    
    <UserControl.Styles>
        <Style Selector="ComboBox /template/ PathIcon">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox:dropdownopen /template/ PathIcon">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <Style Selector="Border.languagecard:pointerover">
            <Setter Property="BorderBrush" Value="#21FFFFFF"/>
        </Style>
    </UserControl.Styles>
    
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1E2127"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#252930"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#171A1F"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4A4F58"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#6E747F"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#6E747F"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A3A8B2"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#ECEEF2"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#ECEEF2"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#C9444A"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D95A5F"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF9F73"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#C9444A"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#D95A5F"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF9F73"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#121418"/>
    </UserControl.Resources>
    
    
    
    <Grid RowDefinitions="70, 74, 74, 74, 74, *" Margin="0, 30,0,0">
        
        
        <!-- Контейнер верхней кнопки General для возврата на предыдущую страницу -->
        <Grid Grid.Row="0">
            <Button Grid.Row="0" BorderBrush="Transparent"
                    Height="50" Width="175" Margin="20,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Cursor="hand" Background="Transparent"
                    CornerRadius="8"
                    Padding="0"
                    Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).RouteBack}">
            
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                </Button.Resources>
            
            
                <Grid ColumnDefinitions="Auto, *">
                    <PathIcon Grid.Column="0" Classes="caret" Data="{markup:IconGeometry Icon=caret_left, IconType=regular}"></PathIcon>
                    <TextBlock Grid.Column="1" Text="Общее" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"></TextBlock>
                </Grid>
            </Button>
        </Grid>
        
        
        
        
        <Border Grid.Row="1" Height="64" CornerRadius="8" Margin="20,0,20,0"
                Background="#171A1F" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="16,0">
            
            <Grid ColumnDefinitions="*,Auto">
                
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Запускать вместе с Windows"
                               FontSize="15" FontWeight="Medium" Foreground="#ECEEF2"/>
                    
                    <TextBlock Text="автозапуск при входе в систему"
                               FontSize="12" Foreground="#A3A8B2"/>
                </StackPanel>
                
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindowsEnable}" Cursor="hand"
                              OnContent="" OffContent="" MinWidth="0" Padding="0"
                              VerticalAlignment="Center" Margin="0,0,-12,0"/>
            </Grid>
        </Border>
        
        
        
        
        <Border Grid.Row="2" Height="64" CornerRadius="8" Margin="20,0,20,0"
                Background="#171A1F" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="16,0">
            
            <Grid ColumnDefinitions="*,Auto">
                
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Сворачивать в трей"
                               FontSize="15" FontWeight="Medium" Foreground="#ECEEF2"/>
                    
                    <TextBlock Text="Закрытие окна не отключает VPN"
                               FontSize="12" Foreground="#A3A8B2"/>
                </StackPanel>
                
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RollTrayEnable}" Cursor="hand"
                              OnContent="" OffContent="" MinWidth="0" Padding="0"
                              VerticalAlignment="Center" Margin="0,0,-12,0"/>
            </Grid>
        </Border>
        
        
        
        
        <Border Grid.Row="3" Height="64" CornerRadius="8" Margin="20,0,20,0"
                Background="#171A1F" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="16,0">
            
            <Grid ColumnDefinitions="*,Auto">
                
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Логирование"
                               FontSize="15" FontWeight="Medium" Foreground="#ECEEF2"/>
                    
                    <TextBlock Text="Журнал работы приложения"
                               FontSize="12" Foreground="#A3A8B2"/>
                </StackPanel>
                
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding WriteLogsEnable}" Cursor="hand"
                              OnContent="" OffContent="" MinWidth="0" Padding="0"
                              VerticalAlignment="Center" Margin="0,0,-12,0"/>
            </Grid>
        </Border>
        
        
        
        
        <Border Grid.Row="4" Height="64" CornerRadius="8" Margin="20,0,20,0"
                Background="#171A1F" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="16,0, 7, 0" Classes="languagecard">

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Язык"
                               FontSize="15" FontWeight="Medium" Foreground="#ECEEF2"/>

                    <TextBlock Text="Язык работы приложения"
                               FontSize="12" Foreground="#A3A8B2"/>
                </StackPanel>

                
                <ComboBox Grid.Column="1"
                          Width="100" Height="32" MinHeight="0"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          CornerRadius="8" BorderThickness="1"
                          Padding="12,0,0,0" FontSize="13"
                          VerticalContentAlignment="Center"
                          Cursor="Hand" SelectedIndex="{Binding LanguageSelectedIndex}">
                    
                    <ComboBoxItem Content="Русский"/>
                    <ComboBoxItem Content="English"/>

                    <ComboBox.Resources>
                        <!-- Поле -->
                        <SolidColorBrush x:Key="ComboBoxBackground" Color="#0E1013"/>
                        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0E1013"/>
                        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0E1013"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#21FFFFFF"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#40FFFFFF"/>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#40FFFFFF"/>
                        <SolidColorBrush x:Key="ComboBoxForeground" Color="#A3A8B2"/>
                        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#ECEEF2"/>
                        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#6E747F"/>

                        <!-- Выпадающая часть и пункты -->
                        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#171A1F"/>
                        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#21FFFFFF"/>
                        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#A3A8B2"/>
                        <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#ECEEF2"/>
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#ECEEF2"/>
                        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#ECEEF2"/>
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1E2127"/>
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#252930"/>
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#252930"/>
                        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2A2E36"/>
                    </ComboBox.Resources>
                </ComboBox>
            </Grid>
        </Border>
        
        
    </Grid>
</UserControl>
