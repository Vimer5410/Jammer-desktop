<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lottie="using:Avalonia.Labs.Lottie"
             xmlns:markup="clr-namespace:PhosphorIconsAvalonia.Markup;assembly=PhosphorIconsAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Jammer_desktop.Views.HomeView"
             xmlns:vm="using:Jammer_desktop.ViewModels"
             x:DataType="vm:HomeViewModel">
    
    
    <UserControl.Styles>
        <!-- плашка консоли стрелка вниз когда свёрнута, вверх когда открыта -->
        <Style Selector="Border.logcard PathIcon.chevron">
            <Setter Property="Foreground" Value="#6E747F"/>
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.logcard.open PathIcon.chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <Style Selector="Border.logcard:pointerover">
            <Setter Property="BorderBrush" Value="#21FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="216,70,*">

        <Grid Grid.Row="0">
            <Grid x:Name="RingHost" Classes="ring" Width="140" Height="140" Margin="0,80,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Кольцо: серая версия всегда видна, цветная проявляется поверх неё при подключении -->
                <Grid.Styles>
                    <Style Selector="Grid.ring lottie|Lottie.color">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="Grid.ring.connected lottie|Lottie.color">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                </Grid.Styles>

                <lottie:Lottie x:Name="RingGray" Width="336" Height="336" IsHitTestVisible="False"
                               Path="avares://Jammer-desktop/Assets/ring_gray.json"
                               RepeatCount="{x:Static lottie:Lottie.Infinity}"/>

                <lottie:Lottie x:Name="RingColor" Classes="color" Width="336" Height="336" IsHitTestVisible="False"
                               Path="avares://Jammer-desktop/Assets/ring_color.json"
                               RepeatCount="{x:Static lottie:Lottie.Infinity}">
                    <lottie:Lottie.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.7" Easing="CubicEaseInOut"/>
                        </Transitions>
                    </lottie:Lottie.Transitions>
                </lottie:Lottie>

                <Button Content="Connect"
                        CornerRadius="100"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="140"
                        Width="140"
                        Padding="0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        BorderThickness="10"
                        Cursor="hand"
                        x:Name="ConnectButton"
                        Click="ConnectButton_OnClick">

                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#1E2127"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#252930"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#171A1F"/>

                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#121418"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#121418"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#121418"/>

                        <SolidColorBrush x:Key="ButtonForeground" Color="#ECEEF2"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                    </Button.Resources>
                </Button>
            </Grid>

        </Grid>

        <Grid Grid.Row="1">
            <TextBox x:Name="ServerIpTextBox"
                     Text="77.221.140.145"
                     Width="220"
                     Height="40"
                     Margin="0,35,0,0"
                     CornerRadius="12"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <TextBox.Resources>

                    <!-- Фон обычный, при наведении и в фокусе -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#0E1013"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E1013"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0E1013"></SolidColorBrush>


                    <!-- Рамка обычная, при наведении и в фокусе -->
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#12FFFFFF"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#21FFFFFF"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C9444A"></SolidColorBrush>


                    <!-- Текст обычный, при наведении и в фокусе -->
                    <SolidColorBrush x:Key="TextControlForeground" Color="#ECEEF2"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#ECEEF2"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"></SolidColorBrush>


                </TextBox.Resources>
            </TextBox>

        </Grid>

        <!-- Сворачиваемая плашка консоли: заголовок со стрелкой, под ним вывод -->
        <Border Grid.Row="2" x:Name="LogCard" Classes="logcard"
                VerticalAlignment="Top"
                Margin="20,10,20,0"
                CornerRadius="12"
                Background="#171A1F" BorderBrush="#12FFFFFF" BorderThickness="1"
                ClipToBounds="True">
            
            <StackPanel>
                <Border x:Name="LogHeader" Height="44" Background="Transparent" Cursor="Hand"
                        PointerPressed="LogHeader_OnPointerPressed">
                    <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                        <TextBlock Text="Журнал подключения" FontSize="13" FontWeight="Medium"
                                   Foreground="#A3A8B2" VerticalAlignment="Center"/>
                        <PathIcon Grid.Column="1" Classes="chevron" Width="12" Height="12" VerticalAlignment="Center"
                                  Data="{markup:IconGeometry Icon=caret_down, IconType=regular}"/>
                    </Grid>
                </Border>

                <Border x:Name="LogBody" IsVisible="False" Height="112"
                        BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="16,10">
                    
                    <ScrollViewer x:Name="LogScrollViewer">
                        <SelectableTextBlock Text="{Binding LogText}"
                                             Foreground="#A3A8B2"
                                             FontFamily="Cascadia Mono, Consolas, monospace"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
