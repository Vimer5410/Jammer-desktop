<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jammer_desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Jammer_desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Height="500"
        Width="350"
        Background="#1A1B21"
        CanResize="False"
        Icon="/Assets/jammer-app.ico"
        Title="Jammer_desktop">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="#22232A"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A2B35"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33343F"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2E2F38"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3C3D49"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#3C3D49"/>
    </Window.Resources>

    <Grid RowDefinitions="*,50,150,70">

        <Grid Grid.Row="0">
            <Button Content="Connect"
                    CornerRadius="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Height="140"
                    Width="140"
                    FontSize="20"
                    FontWeight="SemiBold">

                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#C9444A"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D95A5F"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF9F73"/>

                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C9444A"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D95A5F"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF9F73"/>

                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1A1B21"/>
                </Button.Resources>

            </Button>

        </Grid>

        <Grid Grid.Row="1">
            <TextBox Text="77.221.140.145"
                     Width="220"
                     Height="40"
                     CornerRadius="12"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <TextBox.Resources>

                    <!-- Фон обычный, при наведении и в фокусе -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#22232A"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#272832"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2A2B35"></SolidColorBrush>


                    <!-- Рамка обычная, при наведении и в фокусе -->
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2E2F38"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3C3D49"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C9444A"></SolidColorBrush>


                    <!-- Текст обычный, при наведении и в фокусе -->
                    <SolidColorBrush x:Key="TextControlForeground" Color="#E6E8EE"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E6E8EE"></SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"></SolidColorBrush>


                </TextBox.Resources>
            </TextBox>

        </Grid>

        <Grid Grid.Row="2">
            <Border Background="#121318"
                    BorderBrush="#2E2F38"
                    BorderThickness="1"
                    CornerRadius="0,0,15,15"
                    Margin="0,25,0,6"
                    Padding="12,8">
                <TextBlock Text="Консольный вывод....."
                           Foreground="#7F8596"
                           FontFamily="Cascadia Mono, Consolas, monospace"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left">

                </TextBlock>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Border Background="#121318"
                    BorderBrush="#2E2F38"
                    BorderThickness="1"
                    CornerRadius="15, 15, 0, 0">
                <UniformGrid Columns="2" >


                    <Button CornerRadius="14"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Height="40"
                            Width="40"
                            Margin="0,0,10,0"></Button>


                    <Button CornerRadius="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Height="40"
                            Width="40"
                            Margin="10,0,0,0"></Button>


                </UniformGrid>
            </Border>

        </Grid>

    </Grid>


</Window>
