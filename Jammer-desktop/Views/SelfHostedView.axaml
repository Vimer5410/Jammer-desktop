<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pia="clr-namespace:PhosphorIconsAvalonia.Markup;assembly=PhosphorIconsAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Jammer_desktop.Views.SelfHostedView"
             xmlns:vm="using:Jammer_desktop.ViewModels"
             x:DataType="vm:SelfHostedViewModel">
    
    
    <UserControl.Styles>
        <Style Selector="Button:pressed PathIcon.caret">
            <Setter Property="Foreground" Value="#C9444A"/>
        </Style>
        
        <Style Selector="PathIcon.eye">
            <Setter Property="Data" Value="{pia:IconGeometry Icon=eye_slash, IconType=regular}"/>
            <Setter Property="Foreground" Value="#6E747F"/>
        </Style>
        <Style Selector="ToggleButton:pointerover PathIcon.eye">
            <Setter Property="Foreground" Value="#ECEEF2"/>
        </Style>
        <Style Selector="ToggleButton:checked PathIcon.eye">
            <Setter Property="Data" Value="{pia:IconGeometry Icon=eye, IconType=regular}"/>
            <Setter Property="Foreground" Value="#C9444A"/>
        </Style>
    </UserControl.Styles>
    
    
    <UserControl.Resources>
        <!-- Фон обычный, при наведении и в фокусе -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#0E1013"></SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E1013"></SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0E1013"></SolidColorBrush>


        <!-- Рамка обычная, при наведении и в фокусе -->
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#12FFFFFF"></SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#21FFFFFF"></SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C9444A"></SolidColorBrush>


        <!-- Текст обычный, при наведении и в фокусе -->
        <SolidColorBrush x:Key="TextControlForeground" Color="#ECEEF2"></SolidColorBrush>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#ECEEF2"></SolidColorBrush>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"></SolidColorBrush>
    </UserControl.Resources>
    
    
    
    
    <Grid RowDefinitions="70, 85, 85, 45, *" Margin="0, 30,0,0">
        
        
        <!-- Контейнер верхней кнопки Self-Hosted для возврата на предыдущую страницу -->
        <Grid Grid.Row="0">
            <Button Grid.Row="0" BorderBrush="Transparent"
                    Height="50" Width="175" Margin="20,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Cursor="hand" Background="Transparent"
                    CornerRadius="8"
                    Padding="0"
                    Click="BackButton_OnClick">
            
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                </Button.Resources>
            
            
                <Grid ColumnDefinitions="Auto, *">
                    <PathIcon Grid.Column="0" Classes="caret" Data="{pia:IconGeometry Icon=caret_left, IconType=regular}"></PathIcon>
                    <TextBlock Grid.Column="1" Text="Self-Hosted" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"></TextBlock>
                </Grid>
            </Button>
        </Grid>
        
        
        
        <!-- Контейнер с двумя полями ввода(ip адрес и ssh порт) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="20,0,20,0" ColumnSpacing="20">
            <TextBlock Grid.Column="0" FontFamily="Cascadia Mono, Consolas, monospace" Text="Ip-адрес сервера"></TextBlock>
            <TextBox Grid.Column="0" x:Name="IpTextBox" FontFamily="Cascadia Mono, Consolas, monospace" Height="45" CornerRadius="10" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"></TextBox>
            
            <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas, monospace" Text="SSH port"></TextBlock>
            <TextBox Grid.Column="1" x:Name="SshPortTextBox" FontFamily="Cascadia Mono, Consolas, monospace" Height="45" CornerRadius="10" Text="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></TextBox>
        </Grid>
        
        
        
        <!-- Контейнер с двумя полями ввода(логин и пароль) -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="20,0,20,0" ColumnSpacing="20">
            <TextBlock Grid.Column="0" FontFamily="Cascadia Mono, Consolas, monospace" Text="Логин"></TextBlock>
            <TextBox Grid.Column="0" x:Name="LoginTextBox" FontFamily="Cascadia Mono, Consolas, monospace" Height="45" Width="80" CornerRadius="10" Text="root" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></TextBox>
            
            <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas, monospace" Text="Пароль"></TextBlock>
            <TextBox PasswordChar="*" Grid.Column="1" x:Name="PasswordTextBox" FontFamily="Cascadia Mono, Consolas, monospace" Height="45" CornerRadius="10" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"></TextBox>
            
            <ToggleButton Grid.Column="1" x:Name="ShowPasswordButton" Background="Transparent" HorizontalAlignment="Right" Cursor="Hand" IsCheckedChanged="ShowPasswordButton_OnIsCheckedChanged">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                </ToggleButton.Resources>
                
                <PathIcon Classes="eye"/>
            </ToggleButton>
        </Grid>
        
        
        
        <!-- Контейнер для кнопки Установить -->
        <Grid Grid.Row="3">
            <Button Content="Установить" Width="310" Height="50"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    CornerRadius="12"
                    FontWeight="SemiBold"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    x:Name="InstallButton"
                    Cursor="Hand"
                    Click="InstallServerButton_OnClick">
                
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#C9444A"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D95A5F"/>
                </Button.Resources>
                
            </Button>
        </Grid>
        
        
        
        <!-- Контейнер для вывода информации об установке -->
        <Grid Grid.Row="4" Margin="20,0,20,0">
            <Border BorderBrush="#12FFFFFF"
                    Background="#171A1F" 
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,20,0,10"
                    Padding="12,8">
                
                <ScrollViewer x:Name="LogScrollViewer">
                    <TextBlock Text="{Binding LogText}"
                               Foreground="#A3A8B2"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left">

                    </TextBlock>     
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
